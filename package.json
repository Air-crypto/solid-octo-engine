{
  "name": "solid-octo-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "build": "npm run build:engine && npm run build:dashboard",
    "build:engine": "tsc -p tsconfig.build.json",
    "build:dashboard": "npm run build --workspace @solid-octo/dashboard",
    "check": "npm run typecheck && npm run test",
    "dev": "tsx watch src/index.ts",
    "dev:dashboard": "npm run dev --workspace @solid-octo/dashboard",
    "demo": "tsx src/cli/demo.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "replay": "tsx src/cli/replay.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @solid-octo/dashboard",
    "wallet:create": "tsx src/cli/create-execution-wallet.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@pump-fun/pump-sdk": "^1.33.0",
    "@pump-fun/pump-swap-sdk": "^1.16.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "engines": {
    "node": ">=24"
  }
}

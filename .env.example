# Safe configuration only. Never put a recovery phrase, Phantom password,
# raw private key, or cloud-wallet login in this file.
DESK_MODE=shadow
DESK_HOST=127.0.0.1
DESK_PORT=8787
DESK_DB_PATH=./data/desk.db
DESK_POLICY_PATH=./config/policy.json

# Use authenticated private endpoints for continuous operation.
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Optional. The engine remains fail-closed when a required provider is stale.
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1

# Live execution is disabled unless DESK_MODE=live, a short arm lease is active,
# and a signer adapter is configured. Prefer a dedicated, minimally funded wallet.
SOLANA_EXECUTION_KEYPAIR_PATH=
EXPECTED_SIGNER_PUBLIC_KEY=
# Generate this locally. Never use a wallet password or recovery phrase.
DESK_ARM_TOKEN=
